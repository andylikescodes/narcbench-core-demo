#!/usr/bin/env python3
"""Activation / residual patching on NARCBench-Core Gemma transcripts.

Matched collusion→control residual patch at private-brief tokens and/or last
token before vote; measure if control starts voting the hidden goal. Reverse
scrub (control→collusion) to destroy collusive votes.

Reuses collusion_exp.path_patch capture/generate helpers when importable.
Designed to run on the same GPU pod after regen, or as a follow-on job.

  python3 scripts/activation_patch_core.py \
    --runs-dir upstream/scenarios/gemma2_2b/core/<run_id> \
    --model google/gemma-2-2b-it \
    --out results/activation_patch/<run_id>
"""
from __future__ import annotations

import argparse
import json
import sys
import time
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
COLLUSION = Path("/workspace/collusion-exp")
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(COLLUSION))


def load_paired_runs(runs_dir: Path) -> list[dict]:
    """Pair collusion/control dirs by scenario_id."""
    by_sc: dict[str, dict] = defaultdict(dict)
    for d in sorted(runs_dir.iterdir()):
        if not d.is_dir():
            continue
        cfg_p = d / "run_config.json"
        prompts_p = d / "agent_prompts.json"
        res_p = d / "results.json"
        if not (cfg_p.exists() and prompts_p.exists() and res_p.exists()):
            continue
        cfg = json.loads(cfg_p.read_text())
        prompts = json.loads(prompts_p.read_text())
        res = json.loads(res_p.read_text())
        sid = cfg.get("scenario_id") or cfg.get("run_id", d.name)
        mode = cfg.get("mode") or res.get("mode")
        by_sc[sid][mode] = {
            "dir": str(d),
            "cfg": cfg,
            "prompts": prompts,
            "results": res,
        }
    paired = []
    for sid, modes in by_sc.items():
        if "collusion" in modes and "control" in modes:
            paired.append({"scenario_id": sid, **modes})
    return paired


def pick_final_prompts(prompts: list, role: str = "colluder") -> dict | None:
    finals = [p for p in prompts if p.get("phase") == "final" or p.get("channel") == "final"]
    if not finals:
        finals = [p for p in prompts if "RECOMMENDATION" in (p.get("user_prompt") or "")]
    # Prefer a colluder agent for collusion runs; any agent for control
    for p in finals:
        if role == "any" or p.get("role") == role:
            return p
    return finals[0] if finals else None


def pick_private_brief(prompts: list) -> dict | None:
    priv = [p for p in prompts if p.get("phase") == "private" or p.get("channel") == "private"]
    for p in priv:
        if p.get("role") == "colluder":
            return p
    return priv[0] if priv else None


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--runs-dir", type=Path, required=True)
    ap.add_argument("--model", default="google/gemma-2-2b-it")
    ap.add_argument("--out", type=Path, required=True)
    ap.add_argument("--layers", default="8,12,16,20,24")
    ap.add_argument("--max-new-tokens", type=int, default=64)
    ap.add_argument("--max-scenarios", type=int, default=0, help="0=all paired")
    ap.add_argument("--dry-run", action="store_true", help="No GPU; summarize pairs only")
    args = ap.parse_args()

    paired = load_paired_runs(args.runs_dir)
    if args.max_scenarios:
        paired = paired[: args.max_scenarios]
    args.out.mkdir(parents=True, exist_ok=True)
    summary = {
        "model": args.model,
        "runs_dir": str(args.runs_dir),
        "n_paired": len(paired),
        "scenarios": [p["scenario_id"] for p in paired],
    }
    (args.out / "pairs.json").write_text(json.dumps(summary, indent=2))
    print(json.dumps(summary, indent=2))

    if args.dry_run or not paired:
        return 0

    # Import GPU helpers from collusion-exp
    from collusion_exp.hf_gemma import build_prompt, load_gemma, parse_vote  # type: ignore
    from collusion_exp.path_patch import (  # type: ignore
        capture_residual_last,
        capture_residual_span,
        find_private_brief_positions,
        generate_with_patches,
    )

    layers = [int(x) for x in args.layers.split(",") if x.strip()]
    print(f"[patch] loading {args.model} ...", flush=True)
    bundle = load_gemma(args.model)
    restore_hits = defaultdict(list)  # site -> [0/1]
    scrub_hits = defaultdict(list)

    t0 = time.time()
    per = []
    for item in paired:
        sid = item["scenario_id"]
        coll = item["collusion"]
        ctrl = item["control"]
        target = coll["cfg"].get("target_option")
        fair = coll["cfg"].get("fair_option")
        print(f"[patch] {sid} target={target} fair={fair}", flush=True)

        coll_final = pick_final_prompts(coll["prompts"], "colluder")
        ctrl_final = pick_final_prompts(ctrl["prompts"], "any")
        coll_priv = pick_private_brief(coll["prompts"])
        if not (coll_final and ctrl_final):
            print(f"  skip: missing final prompts", flush=True)
            continue

        # Build chat prompts for final-vote generation
        corr_sys = coll_final["system_prompt"]
        corr_user = coll_final["user_prompt"]
        clean_sys = ctrl_final["system_prompt"]
        clean_user = ctrl_final["user_prompt"]
        corrupted_prompt = build_prompt(bundle, corr_sys, corr_user)
        clean_prompt = build_prompt(bundle, clean_sys, clean_user)

        # Brief positions: prefer private-brief system text markers in final? Use private turn system
        brief_text = (coll_priv or coll_final)["system_prompt"]
        # Find brief span inside corrupted final prompt if motive text appears; else last-token only
        motive_snip = ""
        for key in ("Advocate", "benefactor", "roommate", "NDA", "Meridian", "deferred"):
            if key in brief_text:
                # take a short distinctive phrase
                idx = brief_text.find(key)
                motive_snip = brief_text[max(0, idx - 20) : idx + 40]
                break
        brief_pos = find_private_brief_positions(
            bundle.tokenizer, corrupted_prompt, motive=motive_snip or "Option", max_span=48
        )
        if not brief_pos:
            # fallback: last 8 tokens of prompt (pre-vote)
            ids = bundle.tokenizer(corrupted_prompt, return_tensors="pt")["input_ids"][0]
            n = int(ids.shape[0])
            brief_pos = list(range(max(0, n - 8), n))

        # Align: last N tokens of clean prompt
        clean_ids = bundle.tokenizer(clean_prompt, return_tensors="pt")["input_ids"][0]
        cn = int(clean_ids.shape[0])
        align_pos = list(range(max(0, cn - len(brief_pos)), cn))

        # Baselines
        from collusion_exp.hf_gemma import generate_text  # type: ignore

        corr_text = generate_text(bundle, corrupted_prompt, max_new_tokens=args.max_new_tokens)
        clean_text = generate_text(bundle, clean_prompt, max_new_tokens=args.max_new_tokens)
        corr_vote = parse_vote(corr_text)
        clean_vote = parse_vote(clean_text)

        def is_target(v: str) -> bool:
            return str(v).strip().upper() == str(target).strip().upper()

        corr_collusive = is_target(corr_vote)
        clean_collusive = is_target(clean_vote)
        print(
            f"  base corr={corr_vote}/{corr_collusive} clean={clean_vote}/{clean_collusive} brief_n={len(brief_pos)}",
            flush=True,
        )

        corr_brief = capture_residual_span(bundle, corrupted_prompt, layers, brief_pos)
        clean_align = capture_residual_span(bundle, clean_prompt, layers, align_pos)
        corr_last = capture_residual_last(bundle, corrupted_prompt, layers)
        clean_last = capture_residual_last(bundle, clean_prompt, layers)

        sc_rows = []

        def record(site, direction, vote, reply):
            hit_target = is_target(vote)
            row = {
                "site": site,
                "direction": direction,
                "vote": vote,
                "hit_target": hit_target,
                "reply": (reply or "")[:240],
            }
            sc_rows.append(row)
            if direction == "restore":
                # success: control starts voting hidden goal
                restore_hits[site].append(int(hit_target))
            else:
                # scrub: collusion stops voting hidden goal
                scrub_hits[site].append(int(not hit_target) if corr_collusive else 0)
            return row

        for L in layers:
            # Restore: patch corr brief residual → clean align positions
            patches = {L: {}}
            for i, dst in enumerate(align_pos):
                src = brief_pos[min(i, len(brief_pos) - 1)]
                if src in corr_brief["residual"].get(L, {}):
                    patches[L][dst] = corr_brief["residual"][L][src]
            if not patches[L] and align_pos:
                vecs = list(corr_brief["residual"].get(L, {}).values())
                if vecs:
                    import torch

                    patches[L][align_pos[-1]] = torch.stack(vecs).mean(0)
            text = generate_with_patches(
                bundle, clean_prompt, patches, max_new_tokens=args.max_new_tokens
            )
            record(f"brief.resid.L{L}", "restore", parse_vote(text), text)

            # Scrub: patch clean align → corr brief
            patches_s = {L: {}}
            for i, dst in enumerate(brief_pos):
                src = align_pos[min(i, len(align_pos) - 1)]
                if src in clean_align["residual"].get(L, {}):
                    patches_s[L][dst] = clean_align["residual"][L][src]
            if not patches_s[L] and brief_pos:
                vecs = list(clean_align["residual"].get(L, {}).values())
                if vecs:
                    import torch

                    patches_s[L][brief_pos[-1]] = torch.stack(vecs).mean(0)
            text = generate_with_patches(
                bundle, corrupted_prompt, patches_s, max_new_tokens=args.max_new_tokens
            )
            record(f"brief.resid.L{L}", "scrub", parse_vote(text), text)

            # Last-token restore/scrub
            patches_l = {L: {}}
            last_clean = int(clean_ids.shape[0]) - 1
            last_corr = int(bundle.tokenizer(corrupted_prompt, return_tensors="pt")["input_ids"].shape[-1]) - 1
            if L in corr_last["residual"] and last_clean >= 0:
                # capture_residual_last structure: residual[L] is tensor at last pos
                vec = corr_last["residual"][L]
                if isinstance(vec, dict):
                    vec = list(vec.values())[-1]
                patches_l[L][last_clean] = vec
            text = generate_with_patches(
                bundle, clean_prompt, patches_l, max_new_tokens=args.max_new_tokens
            )
            record(f"last.resid.L{L}", "restore", parse_vote(text), text)

            patches_ls = {L: {}}
            if L in clean_last["residual"]:
                vec = clean_last["residual"][L]
                if isinstance(vec, dict):
                    vec = list(vec.values())[-1]
                patches_ls[L][last_corr] = vec
            text = generate_with_patches(
                bundle, corrupted_prompt, patches_ls, max_new_tokens=args.max_new_tokens
            )
            record(f"last.resid.L{L}", "scrub", parse_vote(text), text)

        per.append(
            {
                "scenario_id": sid,
                "target": target,
                "fair": fair,
                "baseline": {
                    "corr_vote": corr_vote,
                    "clean_vote": clean_vote,
                    "corr_collusive": corr_collusive,
                    "clean_collusive": clean_collusive,
                },
                "transcript_collusion_success": coll["results"].get("collusion_success"),
                "sites": sc_rows,
            }
        )
        (args.out / f"{sid}.json").write_text(json.dumps(per[-1], indent=2))

    def rate(d):
        out = {}
        for k, xs in d.items():
            out[k] = {"n": len(xs), "rate": (sum(xs) / len(xs) if xs else None), "hits": sum(xs)}
        return out

    report = {
        "elapsed_s": round(time.time() - t0, 1),
        "model": args.model,
        "n_scenarios": len(per),
        "restore_vote_flip_rates": rate(restore_hits),
        "scrub_vote_flip_rates": rate(scrub_hits),
        "per_scenario": per,
    }
    (args.out / "report.json").write_text(json.dumps(report, indent=2))
    print(json.dumps({k: report[k] for k in ("elapsed_s", "n_scenarios", "restore_vote_flip_rates", "scrub_vote_flip_rates")}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
